# --- Database ---
POSTGRES_USER=bookmarks
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bookmarks
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- API Server ---
SERVER_PORT=8080
LOG_LEVEL=info

# Must be at least 32 characters long.
# Generate a secure one with: openssl rand -base64 32
JWT_SECRET=change_me_at_least_32_bytes_long

# --- Webhook Dispatcher Integration ---
# URL of the dispatcher.
# On Linux Docker, use http://172.17.0.1:8080 or configure extra_hosts in docker-compose.yml.
# On Mac/Windows, use http://host.docker.internal:8080.
DISPATCHER_URL=http://host.docker.internal:8080

# Must be identical to the INGEST_TOKEN configured in the webhook-dispatcher .env file.
INGEST_TOKEN=change_me_to_match_dispatcher